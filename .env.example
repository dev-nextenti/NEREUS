# NEREUS Marine Intelligence Platform Configuration

# Database
DATABASE_URL=postgresql://nereus_admin:nereus_secure_password@localhost:5432/nereus_marine
# Fallback to local SQLite when PostGIS is not active:
# DATABASE_URL=sqlite:///./nereus.db

# Multi-Agent LLM Provider
LLM_PROVIDER=ollama # "ollama" | "openai"
LLM_URL=http://localhost:11434
LLM_MODEL=llama3.2
OPENAI_API_KEY=

# Indic Speech Engine (Bhashini)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Marine Data Ingestion Live Switches (set true to poll live endpoints)
MOSDAC_LIVE=false
INCOIS_LIVE=false
OPENMETEO_LIVE=true
