# NEREUS Environment Configuration
# Google Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Server Port (default 8000)
PORT=8000

# Managed Database URL (Optional: PostgreSQL/PostGIS e.g. Supabase, Neon, or Render Postgres)
# Defaults to sqlite:///./nereus.db if omitted
DATABASE_URL=postgresql://user:password@hostname:5432/nereus_db

# Frontend API URL (leave empty for same-origin in production Docker)
VITE_API_URL=
